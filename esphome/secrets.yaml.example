# Copy to secrets.yaml beside ikea-vastmarke.yaml.
# Replace EVERY placeholder before flashing. Never commit your real secrets.
# Generate the API key with the command in README.md; it must encode 32 bytes.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "REPLACE_WITH_YOUR_WIFI_PASSWORD"
fallback_ap_password: "REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD"
api_encryption_key: "REPLACE_WITH_A_GENERATED_32_BYTE_BASE64_KEY"
ota_password: "REPLACE_WITH_A_UNIQUE_RANDOM_OTA_PASSWORD"
web_server_username: "REPLACE_WITH_YOUR_WEB_USERNAME"
web_server_password: "REPLACE_WITH_A_UNIQUE_RANDOM_WEB_PASSWORD"
